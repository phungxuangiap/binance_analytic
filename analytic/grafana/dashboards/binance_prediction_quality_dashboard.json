      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-binance-prediction"
          },
          "format": 1,
          "queryType": "sql",
          "rawSql": "WITH bucketed AS (\n  SELECT\n    concat(\n      toString(intDiv(toUInt32(least(percent_accuracy, 99.999)), 10) * 10),\n      '-',\n      toString(intDiv(toUInt32(least(percent_accuracy, 99.999)), 10) * 10 + 10),\n      '%'\n    ) AS accuracy_bucket,\n    intDiv(toUInt32(least(percent_accuracy, 99.999)), 10) * 10 AS bucket_order,\n    count() AS prediction_count\n  FROM binance_prediction.fact_trade_predictions\n  WHERE $__timeFilter(exit_time)\n    AND status = 'closed'\n  GROUP BY accuracy_bucket, bucket_order\n),\ntotal AS (\n  SELECT count() AS total_count\n  FROM binance_prediction.fact_trade_predictions\n  WHERE $__timeFilter(exit_time)\n    AND status = 'closed'\n)\nSELECT\n  accuracy_bucket,\n  prediction_count,\n  if(total_count = 0, 0, prediction_count / total_count * 100) AS prediction_percentage\nFROM bucketed\nCROSS JOIN total\nORDER BY bucket_order",
          "refId": "A"
        }
      ],
      "title": "Predicted Percent Accuracy Distribution",
      "type": "barchart"
    },
